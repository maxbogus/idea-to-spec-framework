flowchart LR
    %% BPMN-приближение процесса записи (UC-1, UC-2).
    %% Канонический BPMN 2.0 — bpmn-process.bpmn.
    Start((Заявка)) --> T1["Клиент выбирает слот<br/>(user task)"]
    T1 --> G1{"Слот свободен?"}
    G1 -->|Да| T2["Создать запись<br/>(service task)"]
    G1 -->|Нет| T3["Предложить другой слот"]
    T3 --> T1
    T2 --> T4["Отправить подтверждение<br/>(service task)"]
    T4 --> G2{"Мастер переносит?"}
    G2 -->|Да| T5["Перенести и уведомить"]
    G2 -->|Нет| T6["Клиент приходит"]
    T5 --> T6
    T6 --> End((Закрыть визит))
