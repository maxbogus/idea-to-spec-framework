    actor P3("P-3 Покупатель")
    actor P4("P-4 Партнёр-продавец")
    systemBoundary "Атрибутор"
        UC1("UC-1 Извлечь атрибуты карточки")
        UC2("UC-2 Обработать партию")
        UC3("UC-3 Проверить сомнительные")
        UC4("UC-4 Добавить категорию")
        UC5("UC-5 Найти по фильтру")
    end
    P1 --> UC1
    P1 --> UC2
    P1 --> UC3
    P2 --> UC4
    P3 --> UC5
